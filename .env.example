CLOUDBASE_ENV_ID=your-environment-id
GRADES_BUCKET=your-private-bucket
EDITOR_PASSWORD_SHA256=
CLOUDBASE_APIKEY=
ALLOWED_ORIGINS=https://your-own-site.example
